# PRISMA (MySQL)
# Replace with your MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/natasun_chat"

# APP (public URLs used by the widget + dashboard)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# WebSocket server
WS_PORT=3001

# AUTH
SESSION_SECRET="replace-with-a-long-random-string"
JWT_SECRET="replace-with-another-long-random-string"

# WebSocket CORS (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8082"

# EMAIL (optional - for notifications)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS=""
MAILER_FROM="Natasun Chat <chat@natasun.com>"
