# PRISMA (MySQL)
# Replace with your MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/natasun_chat"

# APP (public URLs used by the widget + dashboard)
# In production these are behind Caddy: https://your.domain and https://your.domain/socket.io
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# WebSocket server (internal port in the container)
WS_PORT=3001

# AUTH (generate long random strings)
SESSION_SECRET="replace-with-a-long-random-string"
JWT_SECRET="replace-with-another-long-random-string"

# WebSocket CORS (comma-separated). Use "*" to allow the widget to work on
# any customer website (recommended for a public chat service).
ALLOWED_ORIGINS="*"

# App branding defaults (first-time onboarding)
DEFAULT_BRAND_COLOR="#00A76F"
DEFAULT_BRAND_NAME="My Website"

# --- Docker Compose variables (only used if you bundle MySQL with Docker) ---
DB_NAME="natasun_chat"
DB_USER="natasun"
DB_PASS="change-me"
DB_ROOT_PASS="change-me"

# EMAIL (optional - for notifications)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS=""
MAILER_FROM="Natasun Chat <chat@natasun.com>"
